{
  "jest": {
    "verbose": true,
    "collectCoverage": true,
    "coverageDirectory": "<rootDir>/tests/javascript/coverage",
    "collectCoverageFrom": [
      "<rootDir>/static/historic/*.js",
      "!<rootDir>/static/historic/*.min*.js",
      "!<rootDir>/tests/javascript/coverage/**"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "setupFiles": [
      "jest-localstorage-mock",
      "<rootDir>/tests/javascript/test_helpers.js"
    ],
    "testEnvironment": "jsdom",
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "jest-localstorage-mock": "^2.4.26",
    "jest-environment-jsdom": "^30.4.1",
    "canvas": "^3.2.3",
    "jest": "^30.4.2",
    "mock-socket": "^9.3.1"
  }
}
